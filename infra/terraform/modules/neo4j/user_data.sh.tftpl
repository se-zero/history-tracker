#!/bin/bash
# Neo4j 호스트의 첫 부팅 스크립트. cloud-init이 root로 한 번만 실행한다(재부팅 때는 다시 돌지 않는다).
# 비밀번호는 이 스크립트에 없다. 부팅할 때 인스턴스 역할 권한으로 Secrets Manager에서 읽어 온다.
#
# templatefile로 렌더되는 파일이라 달러 기호 바로 뒤에 여는 중괄호가 오면 Terraform이 먼저 해석한다.
# 그래서 bash 변수는 $VAR 꼴만 쓴다. 중괄호가 꼭 필요하면 달러를 두 번 써야 한다.
set -euo pipefail

# 인터넷이 필요한 단계(패키지 설치, 이미지 내려받기)를 재시도로 감싸는 함수다. 10초 간격으로 최대 60번(10분) 시도한다.
# 이 스크립트는 첫 부팅 때 한 번만 도는데, 인스턴스는 인터넷 출구(NAT) 경로가 만들어지기 전에 뜰 수 있다. 재시도가 없으면
# dnf가 실패한 자리에서 스크립트가 멈춰 Neo4j가 없는 인스턴스가 남는다. 일시적인 네트워크 오류도 같은 방식으로 넘긴다.
# 끝내 안 되면 return 1로 실패시킨다. 실패를 삼키면 설치 없이 다음 줄로 넘어가 엉뚱한 곳에서 멈춘다.
retry() {
  for _ in $(seq 1 60); do
    "$@" && return 0
    sleep 10
  done
  return 1
}

retry dnf install -y docker jq

DEVICE=/dev/nvme1n1
MOUNT_POINT=/var/lib/neo4j

# ── 데이터 볼륨 ─────────────────────────────────────────────────────────────
# 볼륨은 인스턴스가 만들어진 뒤에 붙으므로 이 스크립트가 먼저 돈다. 장치가 나타날 때까지 5초 간격으로 최대 5분 기다린다.
# 볼륨을 /dev/sdf로 붙이면 Nitro 인스턴스에서는 NVMe 장치로 보인다.
for _ in $(seq 1 60); do
  [ -b "$DEVICE" ] && break
  sleep 5
done
if [ ! -b "$DEVICE" ]; then
  echo "data volume $DEVICE did not appear within 5 minutes" >&2
  exit 1
fi

# 파일 시스템이 없을 때만 포맷한다. 인스턴스가 교체되면 데이터가 든 볼륨을 붙인 채 이 스크립트가 다시 도는데,
# 무조건 포맷하면 그래프 데이터가 전부 지워진다. blkid -p는 캐시를 거치지 않고 장치를 직접 읽는다.
if ! blkid -p "$DEVICE" >/dev/null 2>&1; then
  mkfs.xfs "$DEVICE"
fi

# fstab에는 장치 이름이 아니라 UUID로 적는다. NVMe 장치 번호는 부팅마다 달라질 수 있다.
# nofail은 볼륨이 없을 때 부팅이 비상 모드에서 멈추지 않게 한다. 그래야 SSM으로 들어가 원인을 볼 수 있다.
UUID=$(blkid -p -s UUID -o value "$DEVICE")
FSTAB_LINE="UUID=$UUID $MOUNT_POINT xfs defaults,nofail 0 2"
grep -qxF "$FSTAB_LINE" /etc/fstab || echo "$FSTAB_LINE" >> /etc/fstab
mkdir -p "$MOUNT_POINT"
mount "$MOUNT_POINT"
mkdir -p "$MOUNT_POINT/data" "$MOUNT_POINT/logs"

# ── docker ──────────────────────────────────────────────────────────────────
# docker는 마운트가 끝난 뒤에만 뜨게 한다. 마운트가 실패했는데 docker가 컨테이너를 되살리면 루트 디스크에
# 새 빈 데이터베이스가 만들어진다. 그러면 데이터가 사라진 것처럼 보이고, 이후 쓰기가 그 위에 쌓인다.
mkdir -p /etc/systemd/system/docker.service.d
cat > /etc/systemd/system/docker.service.d/10-neo4j-data.conf <<'EOF'
[Unit]
RequiresMountsFor=/var/lib/neo4j
EOF
systemctl daemon-reload
systemctl enable --now docker

# ── Neo4j 비밀번호 ──────────────────────────────────────────────────────────
# 리전은 비밀 ARN의 네 번째 필드다(arn:aws:secretsmanager:<리전>:...). 메타데이터(IMDS)에 기대지 않는다.
SECRET_ARN="${secret_arn}"
REGION=$(cut -d: -f4 <<< "$SECRET_ARN")

# 역할 정책이 막 붙은 직후에는 IAM 전파가 늦어 첫 호출이 거절될 수 있다. 10초 간격으로 최대 30번(5분) 다시 시도한다.
# if 조건 안에서 부르므로 실패해도 set -e에 걸리지 않고 다음 시도로 넘어간다.
# jq -e는 비밀에 password 키가 없을 때 jq가 null을 찍고 실패로 끝나게 한다. 그런데 실패한 시도도 찍은 출력은 변수에 대입되므로
# 비우지 않으면 그 null이 아래 빈 값 검사를 통과해 비밀번호가 null인 채로 컨테이너가 뜬다. 그래서 실패할 때마다 변수를 비운다.
# 비밀번호는 변수에만 담는다. 파일이나 로그로 내보내지 않고, bash 실행 추적도 켜지 않는다.
NEO4J_PASSWORD=""
for _ in $(seq 1 30); do
  if NEO4J_PASSWORD=$(aws secretsmanager get-secret-value --secret-id "$SECRET_ARN" --region "$REGION" --query SecretString --output text | jq -er .password); then
    break
  fi
  NEO4J_PASSWORD=""
  sleep 10
done
if [ -z "$NEO4J_PASSWORD" ]; then
  echo "could not read the Neo4j password from Secrets Manager" >&2
  exit 1
fi

# ── Neo4j 컨테이너 ──────────────────────────────────────────────────────────
# 이미지를 먼저 내려받는다. docker run이 알아서 내려받게 두면 첫 시도가 실패했을 때 재시도 없이 스크립트가 멈춘다.
retry docker pull "${neo4j_image}"

# docker-compose.yml과 docker-compose.prod.yml의 neo4j 서비스와 같은 설정이다.
#  - 게시하는 포트는 bolt 7687 하나다. 브라우저(7474)는 열지 않는다.
#  - 컨테이너 메모리 제한(--memory)은 걸지 않는다. compose는 한 호스트를 다른 컨테이너와 나눠 쓰느라 mem_limit이 필요했지만
#    이 호스트는 Neo4j 전용이라 VM이 곧 한계다. 대신 heap·pagecache는 명시한다. 안 하면 Neo4j가 호스트 RAM을 보고 알아서 잡는다.
#  - NEO4J_AUTH는 /data가 비어 있는 첫 기동에만 적용된다. 이미 데이터가 든 볼륨(인스턴스 교체 뒤)에서는 무시되어
#    DB는 처음 만들 때의 비밀번호를 그대로 쓴다. 비밀의 값만 바꿔서는 DB 비밀번호가 바뀌지 않는다.
docker run -d --name neo4j --restart unless-stopped --stop-timeout 60 \
  --log-opt max-size=10m --log-opt max-file=3 \
  -p 7687:7687 \
  -v /var/lib/neo4j/data:/data \
  -v /var/lib/neo4j/logs:/logs \
  -e NEO4J_AUTH="neo4j/$NEO4J_PASSWORD" \
  -e NEO4J_PLUGINS='["apoc"]' \
  -e NEO4J_dbms_security_procedures_unrestricted='apoc.*' \
  -e NEO4J_server_memory_heap_initial__size=${heap_size} \
  -e NEO4J_server_memory_heap_max__size=${heap_size} \
  -e NEO4J_server_memory_pagecache_size=${pagecache_size} \
  ${neo4j_image}
