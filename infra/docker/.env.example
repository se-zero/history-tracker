# History Tracker — 모든 환경변수가 모이는 한 곳.
#
# 사용법:
#   1) 이 파일을 `.env`로 복사: `cp .env.example .env`
#   2) 아래 값들을 채움
#   3) `./dev.sh up -d --build` (또는 `docker compose --profile app up -d --build`)
#
# `.env`는 .gitignore 처리되어 커밋되지 않습니다.

# ============================================================
# Backend — GitHub App OAuth
# ============================================================
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# multi-line PEM은 single-line으로 \n 리터럴 박아서 넣으세요.
# 한 번만 변환하면 됩니다:
#   awk '{printf "%s\\n", $0}' ~/Downloads/...private-key.pem
# 위 출력을 그대로 아래 = 뒤에 붙여넣기 (따옴표 불필요).
GITHUB_APP_PRIVATE_KEY=

# GitHub App settings의 Callback URL과 정확히 일치해야 함.
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback

# (선택) APP_SLUG 있으면 자동 생성되므로 비워두면 됨.
GITHUB_INSTALLATION_URL=

# ============================================================
# Backend — Slack OAuth
# ============================================================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack 앱 OAuth & Permissions > Redirect URLs 에 등록한 값과 정확히 일치해야 함.
# 로컬은 터널 도메인을 쓴다: https://<your-tunnel>/api/v1/integrations/slack/callback
SLACK_REDIRECT_URI=

# ============================================================
# Backend — Jira(Atlassian) OAuth
# ============================================================
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Atlassian 앱 Authorization > OAuth 2.0 (3LO) 의 Callback URL 과 정확히 일치해야 함.
# 로컬은 터널 도메인을 쓴다: https://<your-tunnel>/api/v1/integrations/jira/callback
ATLASSIAN_REDIRECT_URI=

# (선택) Jira access token 갱신 여유 시간(ISO-8601 Duration). 기본 PT5M.
# 로컬에서 갱신 경로를 강제로 타게 하려면 크게 잡는다(예: PT2H로 두면 첫 수집부터 갱신 경로를 탄다).
# ATLASSIAN_REFRESH_SKEW=PT2H

# (선택) Jira 개인정보 보고 배치. 봇 계정 동의(내부 consent 엔드포인트) 완료 후 켠다. 기본 false.
# ATLASSIAN_PDR_ENABLED=true
# (선택) 보고 배치 cron. 기본 매일 03:30.
# ATLASSIAN_PDR_CRON=0 30 3 * * *
# (선택) 보고 주기(ISO-8601 Duration). 기본 P7D.
# ATLASSIAN_PDR_CYCLE_PERIOD=P7D

# ============================================================
# Backend — Discord OAuth
# ============================================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord 앱 OAuth2 > Redirects 에 등록한 값과 정확히 일치해야 함.
# Slack·Jira와 같이 **프론트 오리진**을 써야 한다: https://<your-tunnel>/api/v1/integrations/discord/callback
# 콜백의 302는 상대 경로(/projects/...)라 이 URI의 오리진이 그대로 착지 오리진이 된다 —
# backend(:8080)를 직접 가리키면 연동은 성공해도 마지막 리다이렉트가 401로 끝난다.
# Discord가 localhost를 허용하긴 하지만 그때도 포트는 프론트(5173)여야 한다.
DISCORD_REDIRECT_URI=
# Discord 앱 Bot 탭에서 발급. 앱 전체가 공유하는 값이라 backend·pipeline-worker 양쪽에 같은 값이 전달된다
# (docker-compose가 두 서비스 블록에 동일하게 forward한다) — 수집은 이 봇 토큰으로 한다.
DISCORD_BOT_TOKEN=

# ============================================================
# Backend — Google Chat OAuth
# ============================================================
GOOGLE_CHAT_CLIENT_ID=
GOOGLE_CHAT_CLIENT_SECRET=
# Google Cloud Console > OAuth 동의 화면 > 승인된 리디렉션 URI에 등록한 값과 정확히 일치해야 함.
# Slack·Jira·Discord와 같이 **프론트 오리진**을 써야 한다: https://<your-tunnel>/api/v1/integrations/google-chat/callback
# (콜백의 302가 상대 경로라 이 URI의 오리진이 그대로 착지 오리진이 된다 — backend를 직접 가리키면
# 연동은 성공해도 마지막 리다이렉트가 401로 끝난다. Discord에서 실제로 겪은 사고와 같은 함정이다.)
# 개발 중에는 OAuth 동의 화면 User type을 Internal로 두는 것을 권장한다 — External+Testing은
# refresh token이 7일 만에 만료돼 며칠마다 재동의를 요구한다.
GOOGLE_CHAT_REDIRECT_URI=
# (선택) 만료 전 미리 갱신할 여유 시간(ISO-8601 Duration). 기본 PT5M — 로컬에서 갱신 경로를 바로
# 확인하고 싶으면 크게(예: PT2H) 잡는다.
# GOOGLE_CHAT_REFRESH_SKEW=PT5M
# Cloud Console에서 Chat API 말고 **People API도 별도로 사용 설정**해야 한다 — 사용자 인증으로는
# 메시지 작성자 표시 이름이 Chat API 응답에 오지 않아(실측 확인) People API로 보강하기 때문이다.
# scope에 directory.readonly가 기본 포함돼 있는 이유도 이것이다(services/backend/.../application.yaml).

# ============================================================
# Pipeline worker — GitHub webhook
# ============================================================
# GitHub App settings > General > Webhook secret에 넣은 값과 동일해야 함.
# GitHub이 발급하는 값이 아니라 직접 정하는 값이다 (예: openssl rand -hex 32).
# GitHub은 저장된 secret을 다시 보여주지 않으므로 이 파일이 유일한 사본이 된다.
# 비워두면 모든 webhook이 거부된다(fail-closed) — 초기 수집은 영향 없음.
GITHUB_WEBHOOK_SECRET=

# ============================================================
# AI engine — LLM
# ============================================================
OPENAI_API_KEY=

# (선택) 프로젝트 컨텍스트 prewarm용. 형식: owner/repo
GITHUB_REPO=

# (선택) GitHub API rate limit 회피용 personal access token
GITHUB_TOKEN=

# (선택) 질의(답변) LLM 모델명. 기본값 gpt-5.4-mini
# QUERY_MODEL=gpt-5.4-mini

# (선택) 질의 모델 reasoning 깊이. 미설정 시 API 기본값(medium).
# ※ chat.completions + function tools 조합에서는 'none'만 허용된다 (low/high는 400 에러 —
#   Responses API로 마이그레이션해야 사용 가능). 잘못 설정하면 답변이 조용히 비어서 나온다.
# QUERY_REASONING_EFFORT=

# (선택) 도구 응답 단의 시맨틱 엣지 소비 임계값. 기본 0.5. eval 스윕용 —
# 낮추면 recall↑·오염 위험↑, 올리면 precision↑·recall↓. 프롬프트 안내 문구에도 반영된다.
# TOOLS_MIN_CONFIDENCE=0.5

# (선택) OpenAI rate limiter 한도. 기본값은 Tier 1 기준이며 compose에 박혀 있다.
# Tier를 올리면(예: Tier 3) 아래 값만 수정하면 된다 — 코드 변경 불필요.
#   CHAT  = chat.completions(gpt-4o-mini 등) 버킷, EMBED = embeddings 버킷.
# OPENAI_RPM_CHAT=500
# OPENAI_TPM_CHAT=200000
# OPENAI_RPM_EMBED=3000
# OPENAI_TPM_EMBED=1000000
# OPENAI_MAX_RETRIES=3

# ============================================================
# 인프라 password (비우면 docker-compose의 dev default 사용)
# ============================================================
POSTGRES_PASSWORD=
NEO4J_PASSWORD=

# ============================================================
# 보안 키 (production에서 반드시 변경)
# ============================================================
# JWT_SECRET은 개발 기본값이 있으며, BACKEND_CREDENTIAL_KEY는 32-byte 키의 Base64 값을 필수로 설정
JWT_SECRET=
BACKEND_CREDENTIAL_KEY=
INTERNAL_SERVICE_TOKEN=
