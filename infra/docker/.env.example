# History Tracker — 모든 환경변수가 모이는 한 곳.
#
# 사용법:
#   1) 이 파일을 `.env`로 복사: `cp .env.example .env`
#   2) 아래 값들을 채움
#   3) `./dev.sh up -d --build` (또는 `docker compose --profile app up -d --build`)
#
# `.env`는 .gitignore 처리되어 커밋되지 않습니다.

# ============================================================
# Backend — GitHub App OAuth
# ============================================================
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# multi-line PEM은 single-line으로 \n 리터럴 박아서 넣으세요.
# 한 번만 변환하면 됩니다:
#   awk '{printf "%s\\n", $0}' ~/Downloads/...private-key.pem
# 위 출력을 그대로 아래 = 뒤에 붙여넣기 (따옴표 불필요).
GITHUB_APP_PRIVATE_KEY=

# GitHub App settings의 Callback URL과 정확히 일치해야 함.
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback

# (선택) APP_SLUG 있으면 자동 생성되므로 비워두면 됨.
GITHUB_INSTALLATION_URL=

# ============================================================
# AI engine — LLM
# ============================================================
OPENAI_API_KEY=

# (선택) 프로젝트 컨텍스트 prewarm용. 형식: owner/repo
GITHUB_REPO=

# (선택) GitHub API rate limit 회피용 personal access token
GITHUB_TOKEN=

# (선택) LLM 모델명. 기본값 gpt-4o-mini
# QUERY_MODEL=gpt-4o-mini

# ============================================================
# 인프라 password (비우면 docker-compose의 dev default 사용)
# ============================================================
POSTGRES_PASSWORD=
NEO4J_PASSWORD=

# ============================================================
# 보안 키 (production에서 반드시 변경)
# ============================================================
# JWT_SECRET은 개발 기본값이 있으며, BACKEND_CREDENTIAL_KEY는 32-byte 키의 Base64 값을 필수로 설정
JWT_SECRET=
BACKEND_CREDENTIAL_KEY=
