# History Tracker — 모든 환경변수가 모이는 한 곳.
#
# 사용법:
#   1) 이 파일을 `.env`로 복사: `cp .env.example .env`
#   2) 아래 값들을 채움
#   3) `./dev.sh up -d --build`
#
# `.env`는 .gitignore 처리되어 커밋되지 않습니다.
#
# 포트는 base compose가 아니라 환경별 오버라이드가 소유하므로 `docker compose`를 직접 치지 말고
# `./dev.sh`(로컬) / `./prod.sh`(배포)를 씁니다.
#
# ── 배포(프로덕션) 시 추가로 해야 하는 것 ────────────────────────────
#   · 아래 provider 9종의 redirect URI를 전부 **배포 도메인**으로 바꿔야 합니다.
#     로컬 값이 남아 있으면 그 provider의 연동만 조용히 깨집니다.
#     GITHUB_REDIRECT_URI만은 prod 프로필이 필수로 막습니다(미설정 시 기동 실패).
#   · GitHub App은 등록할 URL이 **두 개**입니다 — Callback URL과 Webhook URL.
#   · 맨 아래 "배포 시 반드시 직접 채운다" 블록의 시크릿을 전부 채워야 합니다.
#   · `TUNNEL_TOKEN`(Cloudflare Tunnel)이 있어야 바깥에서 접근할 수 있습니다.
#     공유기 포트포워딩은 필요 없습니다.
#   전체 절차는 `docs/deployment.md`를 따릅니다.

# ============================================================
# Backend — GitHub App OAuth
# ============================================================
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# multi-line PEM은 single-line으로 \n 리터럴 박아서 넣으세요.
# 한 번만 변환하면 됩니다:
#   awk '{printf "%s\\n", $0}' ~/Downloads/...private-key.pem
# 위 출력을 그대로 아래 = 뒤에 붙여넣기 (따옴표 불필요).
GITHUB_APP_PRIVATE_KEY=

# GitHub App settings의 Callback URL과 정확히 일치해야 함.
# **비워 두면 로컬은 compose 기본값(http://localhost:5173/auth/callback)으로 동작하고,
# 배포(prod 프로필)는 기동이 실패한다.** 여기에 로컬 값을 적어 두면 그대로 배포에 실려
# GitHub 로그인만 조용히 깨지므로, 배포용 값을 넣을 때가 아니면 비워 둔다.
GITHUB_REDIRECT_URI=

# (선택) APP_SLUG 있으면 자동 생성되므로 비워두면 됨.
GITHUB_INSTALLATION_URL=

# (선택) 사용자 access token 갱신 여유 시간(ISO-8601 Duration). 기본 PT5M.
# Expire user authorization tokens가 켜져 있으면 access는 8시간 — 로컬에서 갱신 경로를
# 강제로 타게 하려면 그보다 크게 잡는다(예: PT9H면 발급 직후부터 갱신).
# GITHUB_REFRESH_SKEW=PT9H
# (선택) 사용자 grant 폐기 URL. `{client_id}`는 코드가 치환한다. 기본은 GitHub 공식 엔드포인트.
# GITHUB_GRANT_REVOKE_URL=https://api.github.com/applications/{client_id}/grant

# ============================================================
# Backend — Slack OAuth
# ============================================================
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack 앱 OAuth & Permissions > Redirect URLs 에 등록한 값과 정확히 일치해야 함.
# 로컬은 터널 도메인을 쓴다: https://<your-tunnel>/api/v1/integrations/slack/callback
SLACK_REDIRECT_URI=
# Slack 앱 Basic Information > Signing Secret. Events API 수신에 필요. 비면 서명 검증이 전부 거부(fail-closed).
SLACK_SIGNING_SECRET=

# ============================================================
# Backend — Jira(Atlassian) OAuth
# ============================================================
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Atlassian 앱 Authorization > OAuth 2.0 (3LO) 의 Callback URL 과 정확히 일치해야 함.
# 로컬은 터널 도메인을 쓴다: https://<your-tunnel>/api/v1/integrations/jira/callback
ATLASSIAN_REDIRECT_URI=

# (선택) Jira access token 갱신 여유 시간(ISO-8601 Duration). 기본 PT5M.
# 로컬에서 갱신 경로를 강제로 타게 하려면 크게 잡는다(예: PT2H로 두면 첫 수집부터 갱신 경로를 탄다).
# ATLASSIAN_REFRESH_SKEW=PT2H

# (선택) Jira 개인정보 보고 배치. 봇 계정 동의(내부 consent 엔드포인트) 완료 후 켠다. 기본 false.
# ATLASSIAN_PDR_ENABLED=true
# (선택) 보고 배치 cron. 기본 매일 03:30.
# ATLASSIAN_PDR_CRON=0 30 3 * * *
# (선택) 보고 주기(ISO-8601 Duration). 기본 P7D.
# ATLASSIAN_PDR_CYCLE_PERIOD=P7D

# ============================================================
# Backend — Discord OAuth
# ============================================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord 앱 OAuth2 > Redirects 에 등록한 값과 정확히 일치해야 함.
# Slack·Jira와 같이 **프론트 오리진**을 써야 한다: https://<your-tunnel>/api/v1/integrations/discord/callback
# 콜백의 302는 상대 경로(/projects/...)라 이 URI의 오리진이 그대로 착지 오리진이 된다 —
# backend(:8080)를 직접 가리키면 연동은 성공해도 마지막 리다이렉트가 401로 끝난다.
# Discord가 localhost를 허용하긴 하지만 그때도 포트는 프론트(5173)여야 한다.
DISCORD_REDIRECT_URI=
# Discord 앱 Bot 탭에서 발급. 앱 전체가 공유하는 값이라 backend·pipeline-worker 양쪽에 같은 값이 전달된다
# (docker-compose가 두 서비스 블록에 동일하게 forward한다) — 수집은 이 봇 토큰으로 한다.
DISCORD_BOT_TOKEN=

# ============================================================
# Backend — Google Chat OAuth
# ============================================================
GOOGLE_CHAT_CLIENT_ID=
GOOGLE_CHAT_CLIENT_SECRET=
# Google Cloud Console > OAuth 동의 화면 > 승인된 리디렉션 URI에 등록한 값과 정확히 일치해야 함.
# Slack·Jira·Discord와 같이 **프론트 오리진**을 써야 한다: https://<your-tunnel>/api/v1/integrations/google-chat/callback
# (콜백의 302가 상대 경로라 이 URI의 오리진이 그대로 착지 오리진이 된다 — backend를 직접 가리키면
# 연동은 성공해도 마지막 리다이렉트가 401로 끝난다. Discord에서 실제로 겪은 사고와 같은 함정이다.)
# 개발 중에는 OAuth 동의 화면 User type을 Internal로 두는 것을 권장한다 — External+Testing은
# refresh token이 7일 만에 만료돼 며칠마다 재동의를 요구한다.
GOOGLE_CHAT_REDIRECT_URI=
# (선택) 만료 전 미리 갱신할 여유 시간(ISO-8601 Duration). 기본 PT5M — 로컬에서 갱신 경로를 바로
# 확인하고 싶으면 크게(예: PT2H) 잡는다.
# GOOGLE_CHAT_REFRESH_SKEW=PT5M
# Cloud Console에서 Chat API 말고 **People API도 별도로 사용 설정**해야 한다 — 사용자 인증으로는
# 메시지 작성자 표시 이름이 Chat API 응답에 오지 않아(실측 확인) People API로 보강하기 때문이다.
# scope에 directory.readonly가 기본 포함돼 있는 이유도 이것이다(services/backend/.../application.yaml).

# ============================================================
# Backend — Linear OAuth
# ============================================================
# Linear 앱 설정에서 "Public"을 켜야 authorize가 앱을 찾는다 — 꺼져 있으면
# "Could not find OAuth client with clientId ..." 오류가 난다 (실검증, 2026-08).
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Linear 앱 OAuth Redirect URI에 등록한 값과 정확히 일치해야 함.
# 로컬은 터널 도메인을 쓴다: https://<your-tunnel>/api/v1/integrations/linear/callback
LINEAR_REDIRECT_URI=

# (선택) Linear access token 갱신 여유 시간(ISO-8601 Duration). 기본 PT30M.
# 갱신 경로를 강제로 타게 하려면 토큰 수명(24h)보다 크게 잡는다 — PT25H면 발급 직후에도
# 항상 갱신을 탄다. (PT23H처럼 24h 미만이면 발급 후 "24h - skew"가 지나야 갱신이 시작된다.)
# LINEAR_REFRESH_SKEW=PT25H

# ============================================================
# Backend — Asana OAuth
# ============================================================
# 앱을 "granular" scope로 등록해야 scope 4종(workspaces:read projects:read tasks:read
# users:read) 요청이 유효하다 — "Full permissions"로 등록하면 legacy `default` scope로
# 동작한다 (공식 문서 기준 — 도커 E2E에서 확인).
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
# Asana 앱 OAuth Redirect URI에 등록한 값과 정확히 일치해야 함.
# 로컬은 터널 도메인을 쓴다: https://<your-tunnel>/api/v1/integrations/asana/callback
ASANA_REDIRECT_URI=

# (선택) Asana access token 갱신 여유 시간(ISO-8601 Duration). 기본 PT10M.
# 갱신 경로를 강제로 타게 하려면 토큰 수명(1h)보다 크게 잡는다 — PT2H면 발급 직후에도 항상 갱신을 탄다.
# ASANA_REFRESH_SKEW=PT2H

# ============================================================
# Backend — ClickUp OAuth
# ============================================================
# ClickUp은 scope 개념이 없고(동의 시점에 요청할 권한을 고르지 않는다), access token도 만료가 없다.
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
# ClickUp 앱 OAuth Redirect URI에 등록한 값과 정확히 일치해야 함.
# 로컬은 터널 도메인을 쓴다: https://<your-tunnel>/api/v1/integrations/clickup/callback
CLICKUP_REDIRECT_URI=

# ============================================================
# Backend — Notion OAuth
# ============================================================
# Notion Creator dashboard > Public connections > Configuration에서 발급.
# 다중 사용자 제품은 Internal connection/PAT가 아니라 Public connection(OAuth)을 쓴다.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Notion Public connection의 Redirect URI에 등록한 값과 정확히 일치해야 함.
# 콜백의 302는 상대 경로(/projects/...)라 **프론트 오리진**을 쓴다 — backend(:8080)를 직접
# 가리키면 연동은 성공해도 마지막 리다이렉트가 401로 끝난다.
# 로컬: http://localhost:5173/api/v1/integrations/notion/callback
# 터널/배포: https://<your-tunnel-or-domain>/api/v1/integrations/notion/callback
# Notion에는 로컬·배포 URI를 함께 등록할 수 있지만, 현재 환경에서 쓸 한 값을 여기 설정한다.
NOTION_REDIRECT_URI=

# ============================================================
# Pipeline worker — GitHub webhook
# ============================================================
# GitHub App settings > General > Webhook secret에 넣은 값과 동일해야 함.
# GitHub이 발급하는 값이 아니라 직접 정하는 값이다 (예: openssl rand -hex 32).
# GitHub은 저장된 secret을 다시 보여주지 않으므로 이 파일이 유일한 사본이 된다.
# 비워두면 모든 webhook이 거부된다(fail-closed) — 초기 수집은 영향 없음.
GITHUB_WEBHOOK_SECRET=

# ============================================================
# AI engine — LLM
# ============================================================
OPENAI_API_KEY=

# (선택) 질의(답변) LLM 모델명. 기본값 gpt-5.4-mini
# QUERY_MODEL=gpt-5.4-mini

# (선택) 질의 모델 reasoning 깊이. 미설정 시 API 기본값(medium).
# ※ chat.completions + function tools 조합에서는 'none'만 허용된다 (low/high는 400 에러 —
#   Responses API로 마이그레이션해야 사용 가능). 잘못 설정하면 답변이 조용히 비어서 나온다.
# QUERY_REASONING_EFFORT=

# (선택) 도구 응답 단의 시맨틱 엣지 소비 임계값. 기본 0.5. eval 스윕용 —
# 낮추면 recall↑·오염 위험↑, 올리면 precision↑·recall↓. 프롬프트 안내 문구에도 반영된다.
# TOOLS_MIN_CONFIDENCE=0.5

# (선택) OpenAI rate limiter 한도. 기본값은 Tier 1 기준이며 compose에 박혀 있다.
# Tier를 올리면(예: Tier 3) 아래 값만 수정하면 된다 — 코드 변경 불필요.
#   CHAT  = chat.completions(gpt-4o-mini 등) 버킷, EMBED = embeddings 버킷.
# OPENAI_RPM_CHAT=500
# OPENAI_TPM_CHAT=200000
# OPENAI_RPM_EMBED=3000
# OPENAI_TPM_EMBED=1000000
# OPENAI_MAX_RETRIES=3

# (선택) 수집 동시성·프리페치. 기본값은 코드 기본값과 같고 compose에 박혀 있다.
# **문제가 의심될 때의 킬스위치는 INGEST_CHANGESET_LOOKAHEAD=0이다**
# (완전 복원은 INGEST_EMBED_COALESCE_MAX=1을 함께 준다).
# INGEST_MAX_CONCURRENCY=4
# INGEST_CHANGESET_LOOKAHEAD=8
# INGEST_EMBED_COALESCE_MAX=8
# INGEST_EMBED_COALESCE_WINDOW_MS=50
# 비워 두면 코드가 동시성+look-ahead 합으로 파생한다 — 값을 박으면 그 파생 규칙이 죽는다.
# INGEST_PREFETCH=
# (선택) Slack 필터용 프로젝트 프로필(그래프 요약) 캐시 TTL(초). 기본 24시간 = 프로젝트당 요약 LLM 호출 하루 1회 상한.
# PROJECT_PROFILE_TTL_SECONDS=86400

# ============================================================
# AI engine — 운영자 알림 (선택)
# ============================================================
# OpenAI 잔액 소진·회복 불가 오류·일시 오류(10분 창에 5건 이상 발생)·DLQ/parking 적재를
# 감지해 Slack으로 보낸다. 같은 종류는 1시간에 한 번만 보내고, 비우면 알림 없이 로그만 남긴다.
# ※ 컨테이너 재시작 감지 스크립트(infra/scripts/restart-check.sh)는 이 파일을 읽지 않으므로,
#   같은 URL을 crontab에도 따로 준다 (docs/deployment.md 4-6).
ALERT_SLACK_WEBHOOK_URL=

# ============================================================
# Cloudflare Tunnel (배포 전용)
# ============================================================
# 공개 경로를 터널로 만든다 — 공유기 포트포워딩이 필요 없고, CGNAT 회선에서도 동작하며,
# 집 IP가 드러나지 않는다. TLS는 Cloudflare 엣지에서 끝나므로 인증서 갱신도 없다.
#
# 발급: Cloudflare Zero Trust > Networks > Tunnels > 터널 생성 후 나오는 `eyJ...` 문자열.
# hostname → 서비스 매핑은 대시보드에서 관리한다(Public hostname에
# `<도메인>` → HTTP `web-dashboard:80` 등록). 이 파일에는 토큰만 둔다.
#
# ⚠️ 시크릿이다. 이 토큰 하나로 누구나 같은 터널의 커넥터를 띄울 수 있다.
# 로컬 개발에는 필요 없다(dev 프로필은 터널을 띄우지 않는다).
# 비워 두면 ./prod.sh 가 터널 컨테이너를 기동하다 실패를 반복한다 — 토큰 없이 띄우려면
# `./prod.sh --no-tunnel up -d` 를 쓴다.
TUNNEL_TOKEN=

# ============================================================
# RabbitMQ 계정
# ============================================================
# 비우면 guest/guest로 뜬다. 로컬은 그대로 두어도 되지만 배포에서는 바꾼다.
#
# ⚠️ 비밀번호는 반드시 URL-safe한 값만 쓴다. ai-engine이 이 값을 AMQP URL
#    (amqp://user:password@rabbitmq:5672/) 안에 끼워 넣기 때문에, `/`·`@`·`#`·`?`가 들어가면
#    파서가 vhost나 host로 오인해 연결이 조용히 깨진다.
#    ❌ openssl rand -base64 32   → `+`와 `/`가 섞여 나온다
#    ✅ openssl rand -hex 32      → 0-9a-f만 나온다
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# ============================================================
# 인프라 password · 보안 키 — **배포 시 반드시 직접 채운다**
# ============================================================
# 아래 값들은 비워 두면 코드가 막지 않고 **개발 기본값으로 조용히 뜬다.**
# 특히 JWT_SECRET의 개발 기본값은 이 저장소에 공개돼 있어, 그대로 배포하면 누구나 임의 사용자의
# 토큰을 위조할 수 있다.
# **`./prod.sh`는 이 블록이 비어 있으면 기동을 거부한다**(fail-closed) — POSTGRES_PASSWORD·
# NEO4J_PASSWORD·JWT_SECRET·BACKEND_CREDENTIAL_KEY·INTERNAL_SERVICE_TOKEN 전부. `./dev.sh`는
# 그대로 개발 기본값으로 뜬다(로컬 편의). 즉 개발 기본값이 프로덕션에 새는 경로는 닫혀 있다.
#
# 생성 명령:
#   JWT_SECRET / INTERNAL_SERVICE_TOKEN / POSTGRES_PASSWORD / NEO4J_PASSWORD
#     → openssl rand -hex 32
#     NEO4J_PASSWORD도 hex를 쓰는 이유: compose가 `NEO4J_AUTH: neo4j/<password>` 형식으로 넘기므로
#     값에 `/`가 들어가면 사용자명·비밀번호 경계가 어긋난다 (RabbitMQ와 같은 계열의 함정).
#   BACKEND_CREDENTIAL_KEY  (32-byte 키의 Base64 — 형식이 정해져 있어 hex를 쓰면 안 된다)
#     → openssl rand -base64 32
#
# INTERNAL_SERVICE_TOKEN은 backend·pipeline-worker·ai-engine이, BACKEND_CREDENTIAL_KEY는 backend와
# pipeline-worker가 같은 값을 공유해야 한다.
# BACKEND_CREDENTIAL_KEY를 잃어버리면 저장된 OAuth 자격증명을 **복호화할 수 없다** — DB 백업만으로는
# 복구되지 않으므로 백업과 다른 곳에 따로 보관한다.
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
JWT_SECRET=
BACKEND_CREDENTIAL_KEY=
INTERNAL_SERVICE_TOKEN=
# 무료 → 유료 전환 코드. 미설정이면 업그레이드가 항상 거부된다. 32자 이상 랜덤 문자열 권장.
PLAN_UPGRADE_CODE=
