# docker compose가 자동으로 읽는 .env 파일의 예시.
# 이 파일을 `.env`로 복사하고 값을 채우세요. (`.env`는 .gitignore 처리됨)
#
# 또는 host shell에서 export 한 환경변수가 우선합니다.
# 예: source services/backend/setenv.sh 후 docker compose up

# ─── GitHub App ──────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# multi-line PEM은 \n 리터럴로 박힌 single-line 으로 넣으세요.
# 예: awk '{printf "%s\\n", $0}' private-key.pem 결과를 큰따옴표 안에.
GITHUB_APP_PRIVATE_KEY=

# (선택) app-slug가 있으면 자동 생성되므로 비워둬도 됨
GITHUB_INSTALLATION_URL=

# ─── 보안 키 (production 에서는 반드시 변경) ─────────────────────
JWT_SECRET=local-development-jwt-secret-must-be-changed
BACKEND_CREDENTIAL_KEY=bG9jYWwtY3JlZGVudGlhbC1rZXktMzItYnl0ZXMhISE=
